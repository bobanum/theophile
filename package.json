{
  "name": "theophile",
  "version": "0.1.0",
  "description": "th2 - vanilla JS project using node modules (bundled with esbuild)",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "unpkg": "dist/bundle.standalone.min.js",
  "jsdelivr": "dist/bundle.standalone.min.js",
  "exports": {
    ".": {
      "browser": "./dist/bundle.standalone.min.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "dev": "esbuild src/main.js --bundle --servedir=example --outfile=example/bundle.js --sourcemap --loader:.css=text",
    "build": "npm run build:rollup && npm run build:esbuild",
    "build:rollup": "rollup -c",
    "build:esbuild": "esbuild src/main.js --bundle --minify --outfile=example/bundle.js --loader:.css=text",
    "build:watch": "rollup -c -w",
    "prepublishOnly": "npm run build:rollup",
    "publish:gh-pages": "npm run build:esbuild && npx gh-pages -d example"
  },
  "dependencies": {
    "@bobanum/webponents": "github:bobanum/webponents",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "esbuild": "^0.27.2",
    "gh-pages": "^5.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-postcss": "^4.0.2"
  }
}
